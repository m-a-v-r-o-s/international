{
  "name": "international-rentals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "test:watch": "vitest",
    "db:reset": "tsx scripts/db-apply.ts",
    "types": "SUPABASE_ACCESS_TOKEN=$(grep -m1 '^SUPABASE_ACCESS_TOKEN=' .env.local | cut -d= -f2-) supabase gen types typescript --project-id jhjzcrypzpvevxouuejm > src/lib/supabase/database.generated.ts",
    "purge:licences": "tsx --import ./scripts/loaders/server-only-stub.mjs scripts/purge-licences.ts",
    "keep-alive": "tsx --import ./scripts/loaders/server-only-stub.mjs scripts/keep-alive.ts",
    "postinstall": "node scripts/fix-embedded-pg-libs.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@node-rs/argon2": "^2.0.2",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^16.3.3",
    "next-intl": "^4.4.0",
    "nodemailer": "^9.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.9.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.16.3",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
