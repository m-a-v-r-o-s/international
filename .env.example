# ─────────────────────────────────────────────────────────────────────────────
# International Rentals — environment
#
# Copy to .env.local for development. Nothing in here is committed: .env and
# .env*.local are gitignored, and if a secret ever does land in a commit it gets
# purged from history AND rotated, not deleted in the next commit.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — project URL and the PUBLISHABLE (anon) key. This key reaches the
# browser by design and is safe to publish: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS entirely — must never appear in a NEXT_PUBLIC_
# variable, in client code, or in a log line.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the gate cookie. 32 bytes minimum: openssl rand -base64 48
SESSION_SECRET=

# Direct Postgres connection, for `npm run db:reset` only. Not used at runtime.
DATABASE_URL=

# Phase 4 — licence OCR, server side only, never called from the browser.
ANTHROPIC_API_KEY=

# Phase 5 — Web Push (VAPID). Generate with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Phase 4 — emailing the guest their copy of the signed agreement. Optional:
# with these unset the address is recorded against the contract and the app
# says plainly that no copy was sent. Blocked on the client supplying a domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
